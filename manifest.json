{
  "manifest_version": 3,
  "name": "Komga Light Translator",
  "version": "0.2.1",
  "description": "Lightweight multimodal manga translation overlay with persistent context for Komga.",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Komga Light Translator",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
